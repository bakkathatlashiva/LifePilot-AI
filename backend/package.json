{
  "name": "@lifepilot/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "build:render": "npx prisma generate && npx playwright install chromium chromium-headless-shell && tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "ts-node src/seed.ts",
    "erp:connect": "ts-node src/scripts/connectERP.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "2.4.3",
    "bullmq": "5.34.5",
    "compression": "1.7.4",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "^16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "express-validator": "7.2.1",
    "google-auth-library": "9.15.0",
    "googleapis": "144.0.0",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "node-cron": "3.0.3",
    "openai": "4.77.0",
    "playwright": "1.49.1",
    "prisma": "5.22.0",
    "twilio": "5.3.7",
    "uuid": "11.0.4",
    "web-push": "3.6.7",
    "winston": "3.17.0",
    "zod": "3.24.1",
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/node": "22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "10.0.0",
    "@types/web-push": "3.6.4",
    "firebase-admin": "^14.5.0",
    "typescript": "5.7.2"
  },
  "devDependencies": {
    "ts-node-dev": "2.0.0"
  }
}
