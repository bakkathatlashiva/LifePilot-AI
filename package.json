{
  "name": "lifepilot-ai",
  "version": "1.0.0",
  "private": true,
  "description": "LifePilot AI – Intelligent Personal Assistant monorepo",
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "clean:ports": "powershell -Command \"@(3001, 5173, 8081) | ForEach-Object { $p = (Get-NetTCPConnection -LocalPort $_ -ErrorAction SilentlyContinue).OwningProcess; if ($p) { Stop-Process -Id $p -Force } }\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=web",
    "build:backend": "npm run build --workspace=backend",
    "build:web": "npm run build --workspace=web",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend"
  }
}
